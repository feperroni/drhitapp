# Postgres (no Railway use a referência ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
# Localmente com PGlite use 1; no Railway pode deixar sem definir (padrão 10)
DB_POOL_SIZE=1
# Chaves das notificações push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vinivico82@gmail.com
